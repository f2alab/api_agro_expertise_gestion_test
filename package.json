  "description": "API ERP du Groupe Agro-Expertise - Module IAM (authentification, rôles, permissions, organigramme)",
  "license": "ISC",
  "author": "INNOVERS",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:setup": "node scripts/db-setup.js",
    "db:reset": "node scripts/db-setup.js --reset",
    "db:reset:socle": "node scripts/db-reset-socle.js",
    "db:reset:socle:simulation": "node scripts/db-reset-socle.js --simulation",
    "db:reset:socle:admin": "node scripts/db-reset-socle.js --admin-seul",
    "db:clean": "node scripts/db-clean.js",
    "db:clean:simulation": "node scripts/db-clean.js --simulation",
