# =============================================================================
# GAE - ERP : variables d'environnement (modèle à copier en .env)
#   copy .env.example .env
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=GAE ERP - Module IAM

# --- Base de données PostgreSQL ---------------------------------------------

# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gae_gestiondb
# DB_USER=Geek
# DB_PASSWORD=123456

DB_HOST=ep-twilight-sunset-bba4f3hs-pooler.c-15.us-east-1.aws.neon.tech
PGHOST_UNPOOLED=ep-twilight-sunset-bba4f3hs.c-15.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_NAME=neondb
DB_PASSWORD=npg_tJpBEzcWdV15


DB_POOL_MAX=20
# Neon (et tout PostgreSQL managé) exige une connexion TLS : true.
DB_SSL=true

# --- Sécurité / jetons JWT ---------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-96-caracteres
JWT_REFRESH_SECRET=remplacer-par-un-autre-secret-aleatoire-de-96-caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Politique de sécurité ---------------------------------------------------
BCRYPT_ROUNDS=10
# Threads de calcul dédiés au hachage bcrypt (auto = selon les cœurs, 0 = désactivé).
# bcryptjs bloque le thread unique de Node : les déporter est indispensable
# dès quelques dizaines de connexions simultanées (matin).
HACHAGE_WORKERS=auto
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limitation de débit : comptée PAR UTILISATEUR (identifiant du jeton), avec
# repli sur l'adresse IP. Une limite par IP bloquerait tout le monde derrière
# un même NAT d'entreprise.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=2000
RATE_LIMIT_CONNEXION_MAX=20
# Cache des profils authentifiés (secondes) : supprime 3 requêtes SQL par appel
# d'API. Invalidé immédiatement sur tout changement de compte ou de rôle.
CACHE_AUTH_SECONDES=5
# Cache des réponses agrégées (tableaux de bord, valorisations, finance).
CACHE_REPONSE_SECONDES=20
# Processus de travail : auto = tous les cœurs en production, 1 en développement.
# Une valeur numérique force le nombre de processus (0 = désactivé).
# Si PM2 gère le cluster (instances: max), laissez 0 ou auto pour éviter le double.
CLUSTER_WORKERS=auto

# --- CORS --------------------------------------------------------------------
# Origines autorisées à appeler l'API depuis un navigateur. En production,
# ajouter le(s) domaine(s) du frontend déployé (Firebase Hosting), sinon le
# navigateur bloque la requête (préflight sans Access-Control-Allow-Origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gae-gestion.web.app,https://gae-gestion.firebaseapp.com

# --- Temps réel (flux SSE + LISTEN/NOTIFY PostgreSQL) ------------------------
# TEMPS_REEL_ACTIF=false désactive complètement les notifications (dépannage).
TEMPS_REEL_ACTIF=true
# Fréquence des pings de maintien de connexion (secondes)
TEMPS_REEL_PING_SECONDES=20
# Durée maximale d'un flux avant reconnexion forcée du navigateur (minutes)
TEMPS_REEL_DUREE_MAX_MINUTES=60
# Re-vérification du compte et des permissions pendant le flux (secondes)
TEMPS_REEL_REVALIDATION_SECONDES=300
# Nombre de flux simultanés par utilisateur (un onglet / appareil = un flux)
TEMPS_REEL_FLUX_MAX_PAR_UTILISATEUR=5
# Plafond global de flux par processus (garde-fou mémoire)
TEMPS_REEL_FLUX_MAX_TOTAL=5000